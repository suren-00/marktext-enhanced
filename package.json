{
  "name": "owlmark",
  "private": true,
  "version": "2.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "vite build && electron .",
    "desktop:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.owlmark.app",
    "productName": "OwlMark",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/icon.icns",
      "target": [
        "dmg"
      ]
    }
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  }
}
